# ============================================================
# 大模型配置模板：复制本文件为 backend/.env 后填写真实值
# 三家厂商接口均为 OpenAI 兼容格式，任选其一即可
# ============================================================

# ---- 选项 A：阿里云百炼（通义千问，当前在用）----
# 控制台取 Key：https://bailian.console.aliyun.com/ → 右上角 API-KEY
# 视觉：qwen3.8-flash / qwen3.7-plus / qwen3-vl-plus 等都支持图片输入
# 音频：Qwen-Audio 不支持 OpenAI 兼容协议，走 audio_llm 用 qwen3.8-omni-flash
# 注：旧域名 dashscope.aliyuncs.com 仍可用；也可换成业务空间专属域名
#     https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=你的百炼API-KEY
LLM_MODEL=qwen3.8-flash

# ---- 选项 B：火山方舟（豆包，字节自家）----
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_API_KEY=your_ark_api_key_here
# LLM_MODEL=your_endpoint_id_here          # 火山方舟的"推理接入点 ID"，形如 ep-2025xxxx

# ---- 选项 C：DeepSeek（只有文本，不能做图片/音频识别）----
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-xxxxxxxx
# LLM_MODEL=deepseek-chat

# ---- 可选参数 ----
# LLM_TEMPERATURE=0.3
# LLM_MAX_TOKENS=1200

# ============================================================
# 拍照 / 录音识别（多模态模型）
# ============================================================
# mock：不调模型，返回固定结果，用于没有 Key 时验证前端链路
IDENTIFY_PROVIDER=mock

# 真识别：填一个支持图片输入的模型（OpenAI 兼容即可）
# IDENTIFY_PROVIDER=llm
# IDENTIFY_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# IDENTIFY_API_KEY=your_ark_api_key_here
# IDENTIFY_MODEL=your_vision_endpoint_id
#
# 阿里云百炼的实际填法（qwen3.8-flash 支持图片输入）：
# IDENTIFY_PROVIDER=llm
# IDENTIFY_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# IDENTIFY_API_KEY=sk-xxxxxxxx
# IDENTIFY_MODEL=qwen3.8-flash
# 注：通义 3.5 及以上系列默认开思考模式，代码检测到模型名含 qwen3.5~3.8 会自动传 enable_thinking=false；
#     若想保留思考，设 IDENTIFY_ENABLE_THINKING=1。
#
# MOCK_CRAFT_KEY=景泰蓝            # mock 模式下固定返回的项目

# 音频识别二选一：
#   audio_llm：把音频直接交给多模态模型（需厂商支持 input_audio）
#   asr：先转写成文字，再用文本模型判断归属（兼容性最好，任何厂商都能用）
# 不写 AUDIO_PROVIDER 时，它跟随 IDENTIFY_PROVIDER：上面改成 llm，录音也一起生效，不会漏配。
#
# 注意：音频入口只判京剧 / 皮影戏 / 古琴艺术三项（见 identify.py 的 AUDIO_CRAFT_KEYS），
#       其余项目即使模型报出来也会被丢弃并提示"改用拍照识别"。
# MOCK_AUDIO_CRAFT_KEY=京剧        # mock 模式下音频固定返回的项目，调成工艺类可验证"改拍照"分支
#
# AUDIO_PROVIDER=audio_llm
# AUDIO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# AUDIO_API_KEY=your_ark_api_key_here
# AUDIO_MODEL=your_audio_endpoint_id
#
# AUDIO_PROVIDER=asr
# ASR_BASE_URL=https://api.openai.com/v1
# ASR_API_KEY=sk-xxxxxxxx
# ASR_MODEL=whisper-1
#
# 阿里云百炼：qwen3.8-omni-flash 支持 input_audio，走 audio_llm 这条
# （百炼的 Qwen-Audio / Qwen-Audio-ASR 只支持 DashScope 协议，不能走上面 whisper 兼容的 /audio/transcriptions）
# AUDIO_PROVIDER=audio_llm
# AUDIO_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AUDIO_API_KEY=sk-xxxxxxxx
# AUDIO_MODEL=qwen3.8-omni-flash
# 百炼的 input_audio.data 按 URL/data-URI 解析，纯 base64 会报 invalid URL；
# 模型名含 omni 时代码会自动加 data:audio/xxx;base64, 前缀，其他厂商要求前缀时打开下面这个开关
# AUDIO_DATA_URI=1